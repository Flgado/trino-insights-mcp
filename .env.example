# Copy this to .env (which is gitignored) and fill in your values.
# All variables are prefixed TRINO_INSIGHTS_ and can also be set via
# equivalent CLI flags (see README.md for the full table).

# --- Required ---
TRINO_INSIGHTS_COORDINATOR_URL=http://localhost:8080
TRINO_INSIGHTS_USER=insights

# --- Auth (pick one if your coordinator requires it) ---
# TRINO_INSIGHTS_PASSWORD=
# TRINO_INSIGHTS_TOKEN=

# --- Network ---
# TRINO_INSIGHTS_INSECURE_SKIP_TLS_VERIFY=false
# TRINO_INSIGHTS_TIMEOUT=15s

# --- Tool gating ---
# TRINO_INSIGHTS_TOOLSETS=
# TRINO_INSIGHTS_TOOLS=
# TRINO_INSIGHTS_EXCLUDE_TOOLS=
# TRINO_INSIGHTS_READ_ONLY=true

# --- Performance / caching ---
# TRINO_INSIGHTS_CONTENT_WINDOW_SIZE=16384
# TRINO_INSIGHTS_QUERYINFO_CACHE_TTL=5m
# TRINO_INSIGHTS_QUERYINFO_CACHE_SIZE=256

# --- Logging ---
# TRINO_INSIGHTS_LOG_FILE=
